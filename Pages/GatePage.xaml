<Page
    x:Class="OpenNEL.WinUI.Pages.GatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#101826" Offset="0"/>
                <GradientStop Color="#1B2A44" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <ScrollViewer>
            <StackPanel MaxWidth="500" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Padding="0,40">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" Background="{ThemeResource SystemAccentColor}" Opacity="0.95">
                        <FontIcon Glyph="&#xEB4A;" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PixelNEL" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SubtitleText" Text="Minecraft 启动器 · 需验证后进入" FontSize="13" Opacity="0.7" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CachedUserText" FontSize="11" Opacity="0.5" Foreground="White" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="0" Spacing="0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <RadioButtons x:Name="ModeSelector" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged" HorizontalAlignment="Center" MaxColumns="3" Margin="8,8,8,0">
                        <RadioButton Content="账号登录" MinWidth="140"/>
                        <RadioButton Content="卡密激活" MinWidth="140"/>
                        <RadioButton Content="注册账号" MinWidth="140"/>
                    </RadioButtons>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" Margin="0,8,0,0"/>
                    <StackPanel Padding="28" Spacing="14">

                    <!-- 账号登录 -->
                    <StackPanel x:Name="LoginPanel" Spacing="12">
                        <TextBox x:Name="UsernameBox" Header="用户名" PlaceholderText="用户名 / 邮箱"/>
                        <PasswordBox x:Name="PasswordBox" Header="密码" KeyDown="Password_KeyDown"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="RememberBox" Content="记住账号" IsChecked="True" VerticalAlignment="Center"/>
                            <HyperlinkButton Grid.Column="1" Content="忘记密码？" FontSize="12" IsEnabled="False" Opacity="0.6"/>
                        </Grid>
                        <Button x:Name="LoginButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Login_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FA;" FontSize="14"/><TextBlock Text="登录并进入"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 卡密激活 -->
                    <StackPanel x:Name="LicensePanel" Spacing="12" Visibility="Collapsed">
                        <TextBox x:Name="LicenseKeyBox" Header="卡密" PlaceholderText="CITRINE-XXXX-XXXX-XXXX-XXXX"/>
                        <InfoBar Title="提示" Message="首次使用卡密将自动注册账号并绑定当前设备。" Severity="Informational" IsOpen="True" IsClosable="False"/>
                        <Button x:Name="LicenseButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="License_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8D7;" FontSize="14"/><TextBlock Text="激活并进入"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 注册账号 -->
                    <StackPanel x:Name="RegisterPanel" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="RegUsernameBox" Header="用户名"/><PasswordBox x:Name="RegPasswordBox" Header="密码"/></Grid>
                        <TextBox x:Name="RegEmailBox" Header="邮箱（可选）" PlaceholderText="用于找回"/>
                        <TextBox x:Name="RegKeyBox" Header="注册卡密" PlaceholderText="CITRINE-XXXX..."/>
                        <Button x:Name="RegisterButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Register_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="注册并进入"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Error" IsClosable="True"/>
                <TextBlock x:Name="HwidText" Opacity="0.4" FontSize="11" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

