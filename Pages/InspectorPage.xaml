<Page
    x:Class="OpenNEL.WinUI.Pages.InspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.Background><AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.2" FallbackColor="{ThemeResource SystemChromeMediumLowColor}"/></Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="抓包 Inspector" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="实时查看 data/pe_captures/plain_*.jsonl 与 client_data JWT，快筛 ItemStack/ClientData" Opacity="0.6"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="FileCombo" Grid.Column="0" PlaceholderText="选择抓包文件" SelectionChanged="FileCombo_SelectionChanged"/>
            <TextBox x:Name="FilterBox" Grid.Column="1" PlaceholderText="过滤 PacketName / PacketId (如 ItemStackRequest / 0x93)" TextChanged="FilterBox_TextChanged"/>
            <Button Grid.Column="2" Content="刷新" Click="Refresh_Click"/>
            <Button Grid.Column="3" Content="打开目录" Click="OpenFolder_Click"/>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                <Grid>
                    <ListView x:Name="PacketList" SelectionChanged="PacketList_SelectionChanged" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PacketIdHex}" FontFamily="Consolas" FontSize="12" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PacketName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Direction}" FontSize="11" Opacity="0.5" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Text="请选择文件" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="详情" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailHeader" FontFamily="Consolas" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBox x:Name="DetailBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" FontFamily="Consolas" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="复制 JSON" Click="CopyJson_Click"/>
                            <Button Content="复制 Body Base64" Click="CopyBody_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

