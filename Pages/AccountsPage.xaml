<Page
    x:Class="OpenNEL.WinUI.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Background><AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.2" FallbackColor="{ThemeResource SystemChromeMediumLowColor}"/></Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="账号管理" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="管理你的 PE 账号，支持 Cookie / sauth_json 导入" Opacity="0.6"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,12">
            <TextBox x:Name="CookieBox" PlaceholderText="粘贴 Cookie / sauth_json" Width="420"/>
            <Button Content="添加 PE 账号" Click="AddPE_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="刷新" Click="Refresh_Click"/>
        </StackPanel>
        <Grid Grid.Row="2" MaxWidth="1100" HorizontalAlignment="Stretch">
            <ListView x:Name="AccountList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="Stretch" CornerRadius="8" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Id}" FontSize="12" Opacity="0.6"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Channel}" FontSize="12" Opacity="0.6"/>
                                    <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="重登" Click="Relogin_Click" Tag="{Binding Id}" Margin="4,0" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Grid.Column="2" Content="备注" Click="Alias_Click" Tag="{Binding Id}" Margin="4,0"/>
                            <Button Grid.Column="3" Content="注销" Click="Logout_Click" Tag="{Binding Id}" Margin="4,0"/>
                            <Button Grid.Column="4" Content="删除" Click="Delete_Click" Tag="{Binding Id}" Margin="4,0" Foreground="DarkRed"/>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <InfoBar x:Name="StatusBar" VerticalAlignment="Bottom" IsOpen="False" Severity="Informational"/>
        </Grid>
    </Grid>
</Page>

