<Page
    x:Class="OpenNEL.WinUI.Pages.ModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Center">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="模块" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="模块直接处理已解密的 Bedrock v860 数据包。先在这里配置，再进入服务器测试。" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center" Background="{ThemeResource SystemControlHighlightListAccentLowBrush}">
                    <TextBlock x:Name="BridgeStateText" Text="等待后端" FontSize="12"/>
                </Border>
            </Grid>

            <!-- Killaura is deliberately first: it is a configured feature, not a list row. -->
            <Border CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F9;" FontSize="20"/>
                                <TextBlock Text="Killaura" FontSize="20" FontWeight="SemiBold"/>
                                <Border CornerRadius="5" Padding="6,2" Background="{ThemeResource SystemFillColorCautionBrush}">
                                    <TextBlock Text="v860" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="自动攻击范围内的玩家和生物。会使用当前手持物的真实物品数据发送攻击包。" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="KillauraToggle" Grid.Column="1" OnContent="已开启" OffContent="已关闭" Toggled="Killaura_Toggled" VerticalAlignment="Center"/>
                    </Grid>

                    <Border CornerRadius="7" Padding="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <TextBlock x:Name="KillauraStatusText" Text="已关闭" Opacity="0.8" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Grid ColumnSpacing="24" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                            <TextBlock Text="攻击目标" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch x:Name="KillauraPlayersToggle" Header="玩家" Toggled="KillauraTargets_Toggled"/>
                                <ToggleSwitch x:Name="KillauraMobsToggle" Header="生物" Toggled="KillauraTargets_Toggled"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                            <TextBlock Text="攻击范围" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="KillauraRangeSlider" Minimum="2" Maximum="7" StepFrequency="0.1" ValueChanged="KillauraRange_ValueChanged" Width="200"/>
                                <TextBlock x:Name="KillauraRangeText" VerticalAlignment="Center" MinWidth="42"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                            <TextBlock Text="每秒攻击次数" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="KillauraCpsSlider" Minimum="1" Maximum="20" StepFrequency="1" ValueChanged="KillauraCps_ValueChanged" Width="200"/>
                                <TextBlock x:Name="KillauraCpsText" VerticalAlignment="Center" MinWidth="42"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="提示：启用后切换一次热键栏，模块会自动记住当前手持物。" Opacity="0.55" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Scaffold has its own card because its settings affect movement. -->
            <Border CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="20"/>
                                <TextBlock Text="Scaffold" FontSize="20" FontWeight="SemiBold"/>
                                <Border CornerRadius="5" Padding="6,2" Background="{ThemeResource SystemFillColorAttentionBrush}">
                                    <TextBlock Text="v860" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="在脚下使用当前手持方块自动搭路。参数默认收起，避免模块页再次变得拥挤。" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="ScaffoldToggle" Grid.Column="1" OnContent="已开启" OffContent="已关闭" Toggled="Scaffold_Toggled" VerticalAlignment="Center"/>
                    </Grid>

                    <Border CornerRadius="7" Padding="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <TextBlock x:Name="ScaffoldStatusText" Text="已关闭" Opacity="0.8" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="ScaffoldParametersButton" Content="展开参数" Click="ScaffoldParameters_Click" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="ScaffoldParametersPanel" Visibility="Collapsed" Spacing="12">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="放置频率" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Slider x:Name="ScaffoldRateSlider" Grid.Column="1" Minimum="1" Maximum="12" StepFrequency="1" ValueChanged="ScaffoldRate_ValueChanged" Width="240"/>
                            <TextBlock x:Name="ScaffoldRateText" Grid.Column="2" MinWidth="52" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="开启前请手持可放置方块并切换一次热键栏。区块状态尚未缓存时也会按当前落点尝试放置。" Opacity="0.55" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE706;" FontSize="26" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Night Vision" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="仅修改本机画面，不会向服务器请求效果。" Opacity="0.65" FontSize="12"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="NightVisionToggle" Grid.Column="2" OffContent="关闭" OnContent="开启" Toggled="NightVision_Toggled" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="其他模块" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="通用模块使用简单开关；Killaura、Scaffold 与夜视在上方单独配置。" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="EnabledCountText" Opacity="0.65" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    <ListView x:Name="ModulesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding IsEnabled, Mode=TwoWay}" OnContent="开启" OffContent="关闭" VerticalAlignment="Center" Toggled="ModuleToggle_Toggled" Tag="{Binding Name}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <TextBlock x:Name="LastPacketText" Text="等待已解密的数据包…" FontFamily="Consolas" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

