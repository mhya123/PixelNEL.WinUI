<Page
    x:Class="OpenNEL.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.35" FallbackColor="{ThemeResource SystemChromeMediumLowColor}" />
        </Grid.Background>
        <ScrollViewer Padding="24">
        <Grid ColumnSpacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="16">
            <StackPanel Spacing="4"><TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="游戏路径、皮肤与协议中继" Opacity="0.6"/></StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="PE 游戏路径 (peGamePath)" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GamePathBox" PlaceholderText="例如 C:\MCLDownload\MinecraftBENeteasePath\x64_mc"/>
                    <Button Grid.Column="1" Content="浏览" Click="BrowseGamePath_Click"/>
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="皮肤路径 (peSkinPath)" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SkinPathBox" PlaceholderText="皮肤 PNG 路径" TextChanged="SkinPath_TextChanged"/>
                    <Button Grid.Column="1" Content="浏览" Click="BrowseSkin_Click"/>
                </Grid>
                <CheckBox x:Name="SlimBox" Content="纤细模型 (Alex)" Checked="SlimBox_Changed" Unchecked="SlimBox_Changed"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="启动内存 (MB)" FontWeight="SemiBold"/>
                <NumberBox x:Name="MemoryBox" Minimum="1024" Maximum="16384" SmallChange="512" LargeChange="1024" SpinButtonPlacementMode="Inline"/>
            </StackPanel>
            <CheckBox x:Name="MitmCheck" Content="启用 PE MITM 解密 (需要重启进服生效)"/>
            <StackPanel Spacing="8">
                <CheckBox x:Name="InternationalRelayCheck" Content="国际基岩版 → 网易 v860 协议中继（实验性）"/>
                <TextBlock Text="启用后会使用当前网易账号生成服务端登录凭据，并将国际版 RakNet 11 转换为网易 RakNet 8 / Bedrock 860。"
                           Opacity="0.6" TextWrapping="Wrap" Margin="28,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="28,0,0,0">
                    <TextBlock Text="国际版客户端版本：" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RelayV827Radio" GroupName="RelayFrontend" Content="1.21.100 (v827)" IsChecked="True"/>
                    <RadioButton x:Name="RelayV844Radio" GroupName="RelayFrontend" Content="1.21.111 (v844)"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="重新加载" Click="Reload_Click"/>
            </StackPanel>
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational"/>
            </StackPanel>
            <!-- 3D 皮肤预览 -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12" VerticalAlignment="Top"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="皮肤 3D 预览" FontWeight="SemiBold"/>
                    <Grid Height="340" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Image x:Name="SkinPreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="SkinPreviewPlaceholder" Text="未选择皮肤&#x0a;选择 PNG 后自动预览" TextAlignment="Center" Opacity="0.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Border x:Name="SkinPreviewError" Visibility="Collapsed" Background="#33000000" CornerRadius="8" Padding="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="SkinErrorText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新预览" Click="RefreshSkinPreview_Click"/>
                        <Button Content="打开皮肤文件" Click="OpenSkinFile_Click"/>
                    </StackPanel>
                    <TextBlock Text="支持 64×64 标准皮肤，64×32 旧格式自动兼容。Alex/Slim 切换即时生效。" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>

