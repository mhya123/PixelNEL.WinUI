<Page
    x:Class="OpenNEL.WinUI.Pages.PeServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.Background><AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.2" FallbackColor="{ThemeResource SystemChromeMediumLowColor}"/></Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Text="联机大厅" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="探索精彩的 Minecraft 服务器世界" Opacity="0.6"/>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,16,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索服务器名称或关键词..." TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="AccountCombo" Grid.Column="1" PlaceholderText="选择账号" SelectionChanged="AccountCombo_SelectionChanged"/>
            <ComboBox x:Name="ModeCombo" Grid.Column="2" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="联机大厅" Tag="network"/>
                <ComboBoxItem Content="租赁服" Tag="rental"/>
            </ComboBox>
            <Button Grid.Column="3" Content="刷新" Click="Refresh_Click"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Server list -->
            <Border Grid.Column="0" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="0" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="ServerList" SelectionChanged="ServerList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Brief}" Opacity="0.6" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="在线:"/><Run Text="{Binding OnlineCount}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" VerticalAlignment="Center" Opacity="0.4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Text="暂无服务器" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                </Grid>
            </Border>

            <!-- Detail panel -->
            <Border Grid.Column="1" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="服务器详情" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="DetailText" Text="请选择一个服务器" TextWrapping="Wrap" Opacity="0.7"/>
                        <ProgressRing x:Name="DetailRing" IsActive="False" Width="24" Height="24"/>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>
                        <TextBlock Text="角色" FontWeight="SemiBold"/>
                        <ComboBox x:Name="RoleCombo" PlaceholderText="选择角色" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="RoleNameBox" PlaceholderText="新昵称" Width="160"/>
                            <Button Content="创建" Click="CreateRole_Click"/>
                        </StackPanel>
                        <TextBox x:Name="PasswordBox" PlaceholderText="租赁服密码（可选）" Visibility="Collapsed"/>
                        <Button x:Name="LaunchButton" Content="启动游戏" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Launch_Click"/>
                        <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" Title="状态" Message="等待启动"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="LaunchStatusText" Margin="0,8,0,0" Opacity="0.7" Text="等待启动" TextWrapping="Wrap"/>
    </Grid>
</Page>

