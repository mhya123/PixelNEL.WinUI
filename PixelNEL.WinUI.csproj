<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenNEL.WinUI</RootNamespace>
    <AssemblyName>PixelNEL.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>D:\blur\Assets\PixelNEL.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SupportsHotReload>false</SupportsHotReload>
    <EnableXamlDiagnostics>false</EnableXamlDiagnostics>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenNEL">
      <HintPath>D:\blur\Source\OpenNEL\bin\Release\net10.0\OpenNEL.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenNEL.Core">
      <HintPath>D:\blur\OpenNEL.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenNEL.LocalApi">
      <HintPath>D:\blur\Source\OpenNEL.LocalApi\bin\Release\net10.0\OpenNEL.LocalApi.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenNEL.UI">
      <HintPath>D:\blur\Source\OpenNEL.UI\bin\Release\net10.0\OpenNEL.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="D:\blur\Assets\PixelNEL.ico" Link="Assets\PixelNEL.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
